# Cada proyecto clase-XX trae su propio .gitignore.
# Este es la red de seguridad a nivel repositorio.

node_modules/
dist/
.angular/
/tmp
/out-tsc
*.tsbuildinfo

# Secretos. El repositorio es público: nada de esto se commitea.
*.local.md
.env
.env.*
!.env.example
**/environments/environment.secrets.ts
.supabase/

# Editores
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.history/

# Sistema
.DS_Store
Thumbs.db
